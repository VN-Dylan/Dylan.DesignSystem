shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
dedupe-peer-dependents=true
link-workspace-packages=true
prefer-workspace-packages=true

# The @vn-dylan/* packages publish to GitHub Packages. Workspace deps resolve
# locally via the `workspace:*` protocol, so this only matters when publishing
# (the release workflow appends the matching `//npm.pkg.github.com/:_authToken`
# line at run time) or when this same repo is a consumer elsewhere.
@vn-dylan:registry=https://npm.pkg.github.com
