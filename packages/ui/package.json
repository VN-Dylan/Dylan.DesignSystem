{
  "name": "@vn-dylan/ui",
  "version": "0.1.0",
  "description": "React component library for the Dylan Design System.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VN-Dylan/Dylan.DesignSystem.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@vn-dylan/icons": "workspace:*",
    "@vn-dylan/tokens": "workspace:*",
    "@vn-dylan/utils": "workspace:*",
    "@floating-ui/react": "0.27.3",
    "@tanstack/react-table": "8.20.6",
    "@tiptap/pm": "2.10.3",
    "@tiptap/react": "2.10.3",
    "@tiptap/starter-kit": "2.10.3",
    "apexcharts": "4.3.0",
    "jsvectormap": "1.6.0",
    "react-apexcharts": "1.7.0",
    "react-syntax-highlighter": "15.6.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "react-icons": "5.4.0",
    "sass": "1.83.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  }
}
