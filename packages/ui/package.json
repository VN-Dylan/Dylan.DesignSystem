    "react-syntax-highlighter": "15.6.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "react-icons": "5.4.0",
    "sass": "1.83.0",
