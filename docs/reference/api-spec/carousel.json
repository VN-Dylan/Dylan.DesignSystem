{"url":"https://eyris-react.themenate.net/ui-components/carousel","title":"Carousel","intro":"A carousel with motion and swipe built without external dependencies.","sections":["Basic","Vertical","Loop","With API","Sizes","Button Positioning","API","Carousel","Carousel.Content","Carousel.Item","Carousel.Previous / Carousel.Next"],"code":["import Carousel from '@/components/ui/Carousel'\nimport Card from '@/components/ui/Card'\n\nconst Basic = () => {\n    return (\n        <div className=\"w-full max-w-xs mx-auto\">\n            <div className=\"relative\">\n                <Carousel>\n                    <Carousel.Content>\n                        {Array.from({ length: 5 }).map((_, index) => (\n                            <Carousel.Item key={index}>\n                                <Card className=\"p-1\">\n                                    <div className=\"flex aspect-square items-center justify-center p-6\">\n                                        <span className=\"text-4xl font-semibold\">\n                                            {index + 1}\n                                        </span>\n                                    </div>\n                                </Card>\n                            </Carousel.Item>\n                        ))}\n                    </Carousel.Content>\n                    <Carousel.Previous className=\"absolute -left-12 top-1/2 -translate-y-1/2\" />\n                    <Carousel.Next className=\"absolute -right-12 top-1/2 -translate-y-1/2\" />\n                </Carousel>\n            </div>\n        </div>\n    )\n}\n\nexport default Basic\n","import Carousel from '@/components/ui/Carousel'\nimport Card from '@/components/ui/Card'\n\nconst Vertical = () => {\n    return (\n        <div className=\"w-full max-w-xs mx-auto\">\n            <div className=\"h-[330px] py-12 relative\">\n                <Carousel orientation=\"vertical\">\n                    <Carousel.Content className=\"h-[250px]\">\n                        {Array.from({ length: 5 }).map((_, index) => (\n                            <Carousel.Item key={index} className=\"basis-full\">\n                                <Card className=\"p-1\">\n                                    <div className=\"flex h-[180px] items-center justify-center p-6\">\n                                        <span className=\"text-4xl font-semibold\">\n                                            {index + 1}\n                                        </span>\n                                    </div>\n                                </Card>\n                            </Carousel.Item>\n                        ))}\n                    </Carousel.Content>\n                    <Carousel.Previous className=\"absolute -top-12 left-1/2 -translate-x-1/2\" />\n                    <Carousel.Next className=\"absolute -bottom-12 left-1/2 -translate-x-1/2\" />\n                </Carousel>\n            </div>\n        </div>\n    )\n}\n\nexport default Vertical\n","import Carousel from '@/components/ui/Carousel'\nimport Card from '@/components/ui/Card'\n\nconst Loop = () => {\n    return (\n        <div className=\"w-full max-w-xs mx-auto\">\n            <div className=\"relative\">\n                <Carousel opts={{ loop: true }}>\n                    <Carousel.Content>\n                        {Array.from({ length: 5 }).map((_, index) => (\n                            <Carousel.Item key={index}>\n                                <Card className=\"p-1\">\n                                    <div className=\"flex aspect-square items-center justify-center p-6\">\n                                        <span className=\"text-4xl font-semibold\">\n                                            {index + 1}\n                                        </span>\n                                    </div>\n                                </Card>\n                            </Carousel.Item>\n                        ))}\n                    </Carousel.Content>\n                    <Carousel.Previous className=\"absolute -left-12 top-1/2 -translate-y-1/2\" />\n                    <Carousel.Next className=\"absolute -right-12 top-1/2 -translate-y-1/2\" />\n                </Carousel>\n            </div>\n        </div>\n    )\n}\n\nexport default Loop\n","import { useState, useEffect } from 'react'\nimport Carousel from '@/components/ui/Carousel'\nimport Card from '@/components/ui/Card'\nimport type { CarouselApi } from '@/components/ui/Carousel'\n\nconst WithApi = () => {\n    const [api, setApi] = useState<CarouselApi>()\n    const [current, setCurrent] = useState(0)\n    const [count, setCount] = useState(0)\n\n    useEffect(() => {\n        if (!api) return\n\n        setCount(api.scrollSnapCount)\n        setCurrent(api.selectedIndex + 1)\n    }, [api])\n\n    useEffect(() => {\n        if (api && api.selectedIndex + 1 !== current) {\n            setCurrent(api.selectedIndex + 1)\n        }\n    }, [api, current])\n\n    return (\n        <div className=\"w-full max-w-xs mx-auto\">\n            <div className=\"relative\">\n                <Carousel setApi={setApi}>\n                    <Carousel.Content>\n                        {Array.from({ length: 5 }).map((_, index) => (\n                            <Carousel.Item key={index}>\n                                <Card className=\"p-1\">\n                                    <div className=\"flex aspect-square items-center justify-center p-6\">\n                                        <span className=\"text-4xl font-semibold\">\n                                            {index + 1}\n                                        </span>\n                                    </div>\n                                </Card>\n                            </Carousel.Item>\n                        ))}\n                    </Carousel.Content>\n                    <Carousel.Previous className=\"absolute -left-12 top-1/2 -translate-y-1/2\" />\n                    <Carousel.Next className=\"absolute -right-12 top-1/2 -translate-y-1/2\" />\n                </Carousel>\n            </div>\n            <div className=\"py-2 text-center\">\n                Slide {current} of {count}\n            </div>\n        </div>\n    )\n}\n\nexport default WithApi\n","import Carousel from '@/components/ui/Carousel'\nimport Card from '@/components/ui/Card'\n\nconst Sizes = () => {\n    return (\n        <div className=\"w-full max-w-sm mx-auto\">\n            <div className=\"relative\">\n                <Carousel>\n                    <Carousel.Content className=\"-ml-2 md:-ml-4\">\n                        {Array.from({ length: 5 }).map((_, index) => (\n                            <Carousel.Item\n                                key={index}\n                                className=\"pl-2 md:pl-4 basis-1/2 md:basis-1/3\"\n                            >\n                                <Card>\n                                    <div className=\"flex aspect-square items-center justify-center p-6\">\n                                        <span className=\"text-3xl font-semibold\">\n                                            {index + 1}\n                                        </span>\n                                    </div>\n                                </Card>\n                            </Carousel.Item>\n                        ))}\n                    </Carousel.Content>\n                    <Carousel.Previous className=\"absolute -left-12 top-1/2 -translate-y-1/2\" />\n                    <Carousel.Next className=\"absolute -right-12 top-1/2 -translate-y-1/2\" />\n                </Carousel>\n            </div>\n        </div>\n    )\n}\n\nexport default Sizes\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["orientation","The orientation of the carousel","'horizontal' | 'vertical'","'horizontal'"],["opts","Carousel options","{ loop?: boolean, startIndex?: number }","{}"],["setApi","Callback to receive the carousel API","(api: CarouselApi) => void","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["className","Additional CSS classes for the content container","string","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["className","Additional CSS classes for the item (use basis-* for sizing)","string","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["className","CSS classes for positioning and styling (no built-in positioning)","string","-"],["variant","Button variant style","'solid' | 'subtle' | 'default' | 'ghost' | 'link'","'default'"],["size","Button size","'sm' | 'md' | 'lg'","'sm'"]]]}