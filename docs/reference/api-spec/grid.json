=\"bg-purple-300 dark:bg-purple-800 dark:text-purple-400\">\n                04\n            </DemoBoxContent>\n            <DemoBoxContent className=\"bg-purple-300 dark:bg-purple-800 dark:text-purple-400\">\n                05\n            </DemoBoxContent>\n        </div>\n    )\n}\n\nexport default GridAutoflow\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst GridAutoColumns = () => {\n    return (\n        <div className=\"grid grid-flow-col auto-cols-max gap-4\">\n            <DemoBoxContent className=\"shadow-lg bg-emerald-500\">\n                01\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-emerald-500\">\n                02\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-emerald-500\">\n                03\n            </DemoBoxContent>\n        </div>\n    )\n}\n\nexport default GridAutoColumns\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst HoverFocus = () => {\n    return (\n        <div className=\"grid hover:grid-cols-1 grid-cols-6 gap-4\">\n            <DemoBoxContent className=\"shadow-lg bg-violet-500\">\n                01\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-violet-500\">\n                02\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-violet-500\">\n                03\n            </DemoBoxContent>\n        </div>\n    )\n}\n\nexport default HoverFocus\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst BreakpointsMediaQueries = () => {\n    return (\n        <div className=\"grid grid-cols-1 md:grid-cols-6 gap-4\">\n            <DemoBoxContent className=\"shadow-lg bg-cyan-500\">\n                01\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-cyan-500\">\n                02\n            </DemoBoxContent>\n            <DemoBoxContent className=\"shadow-lg bg-cyan-500\"