Content className=\"bg-indigo-300 dark:bg-indigo-800 dark:text-indigo-400\">\n                    05\n                </DemoBoxContent>\n            </div>\n            <div className=\"...\">\n                <DemoBoxContent className=\"bg-indigo-300 dark:bg-indigo-800 dark:text-indigo-400\">\n                    06\n                </DemoBoxContent>\n            </div>\n            <div className=\"col-span-2 ...\">\n                <DemoBoxContent className=\"shadow-lg bg-indigo-500\">\n                    07\n                </DemoBoxContent>\n            </div>\n        </div>\n    )\n}\n\nexport default GridColumnStartEnd\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst GridColumnStartEndLine = () => {\n    return (\n        <div className=\"grid grid-cols-6 gap-4\">\n            <DemoBoxContent className=\"col-start-2 col-span-4 shadow-lg bg-sky-500\">\n                01\n            </DemoBoxContent>\n            <DemoBoxContent className=\"col-start-1 col-end-3 shadow-lg bg-sky-500\">\n                02\n            </DemoBoxContent>\n            <DemoBoxContent className=\"col-end-7 col-span-2 shadow-lg bg-sky-500\">\n                03\n            </DemoBoxContent>\n            <DemoBoxContent className=\"col-start-1 col-end-7 shadow-lg bg-sky-500\">\n                04\n            </DemoBoxContent>\n        </div>\n    )\n}\n\nexport default GridColumnStartEndLine\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst GridTemplateRows = () => {\n    return (\n        <div className=\"grid grid-rows-4 grid-flow-col gap-4\">\n            {[...Array(9).keys()].map((elm) => (\n                <DemoBoxContent key={elm} className=\"shadow-lg bg-pink-500\">\n                    {'0' + (elm + 1)}\n                </DemoBoxContent>\n            ))}\n        </div>\n    )\n}\n\nexport default GridTemplateRows\n","import DemoBoxContent from '@/components/docs/DemoBoxContent'\n\nconst GridRowStartEndLine = () => {\n 