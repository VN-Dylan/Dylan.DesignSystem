{"url":"https://eyris-react.themenate.net/guide/shared-component-doc/statistic-card","title":"StatisticCard","intro":"StatisticCard is a card component designed for displaying statistical data with optional header and footer sections.","sections":["Basic","1,862","Inset","1,862","With Header & Footer","$1,862","With Inset Footer","$1,862","With Inset Header","$1,862","API","StatisticCard"],"code":["import Button from '@/components/ui/Button'\nimport Dropdown from '@/components/ui/Dropdown'\nimport StatisticCard from '@/components/shared/StatisticCard'\nimport { LuEllipsisVertical } from 'react-icons/lu'\nimport { LiEye, LiEdit, LiCopy } from '@/icons'\n\nconst WithHeaderFooter = () => {\n    return (\n        <div className=\"w-full max-w-sm mx-auto\">\n            <StatisticCard\n                header={\n                    <div className=\"flex items-center justify-between\">\n                        <span className=\"heading-text font-medium\">Sales</span>\n                        <Dropdown\n                            placement=\"bottom-end\"\n                            renderTitle={\n                                <Button\n                                    icon={<LuEllipsisVertical />}\n                                    size=\"sm\"\n                                    variant=\"ghost\"\n                                />\n                            }\n                        >\n                            <Dropdown.Item eventKey=\"viewMore\">\n                                <LiEye className=\"text-lg\" />\n                                <span>View More</span>\n                            </Dropdown.Item>\n                            <Dropdown.Item eventKey=\"edit\">\n                                <LiEdit className=\"text-lg\" />\n                                <span>Edit</span>\n                            </Dropdown.Item>\n                            <Dropdown.Item eventKey=\"copy\">\n                                <LiCopy className=\"text-lg\" />\n                                <span>Copy</span>\n                            </Dropdown.Item>\n                        </Dropdown>\n                    </div>\n                }\n                footer={\n                    <div className=\"flex items-center justify-end\">\n                        <Button size=\"sm\">View Report</Button>\n                    </div>\n                }\n            >\n                <div>\n                    <h4>$1,862</h4>\n                    <div className=\"flex items-center gap-1\">\n                        <span>vs yesterday</span>\n                        <span className=\"font-medium text-success\">+12.5%</span>\n                    </div>\n                </div>\n            </StatisticCard>\n        </div>\n    )\n}\n\nexport default WithHeaderFooter\n","import StatisticCard from '@/components/shared/StatisticCard'\nimport { LiDollarCircle } from '@/icons'\n\nconst WithInsetFooter = () => {\n    return (\n        <div className=\"w-full max-w-sm mx-auto\">\n            <StatisticCard\n                inset\n                footer={\n                    <div className=\"flex items-center justify-between px-2\">\n                        <span className=\"font-medium text-success\">+12.5%</span>\n                        <span>vs last period</span>\n                    </div>\n                }\n            >\n                <div className=\"space-y-4\">\n                    <div className=\"h-10 w-10 flex items-center justify-center rounded-lg text-xl border border-gray-200 dark:border-gray-700 heading-text\">\n                        <LiDollarCircle />\n                    </div>\n                    <div>\n                        <h4>$1,862</h4>\n                        <span>Total Revenue</span>\n                    </div>\n                </div>\n            </StatisticCard>\n        </div>\n    )\n}\n\nexport default WithInsetFooter\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["inset","Whether to use the inset variant with a subtle background","boolean","-"],["header","Content to display in the card header","ReactNode | string","-"],["footer","Content to display in the card footer","ReactNode | string","-"],["bodyClass","Additional CSS classes for the card body","string","-"],["className","Additional CSS classes for the card container","string","-"],["children","Main content of the card","ReactNode","-"]]]}