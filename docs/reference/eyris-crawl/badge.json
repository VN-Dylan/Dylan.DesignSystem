{"url":"https://eyris-react.themenate.net/ui-components/badge","title":"Badge","intro":"Badges often used to highlight an item's status to notify the user.","sections":["Basic","Count Overflow","Dot","Inline","Color","API","Badge"],"code":["import Avatar from '@/components/ui/Avatar'\nimport Badge from '@/components/ui/Badge'\nimport { TbUser } from 'react-icons/tb'\n\nconst Basic = () => {\n    return (\n        <div className=\"flex items-center\">\n            <Badge className=\"mr-4\" content={9}>\n                <Avatar icon={<TbUser />} />\n            </Badge>\n            <Badge className=\"mr-4\" content={'New'}>\n                <Avatar icon={<TbUser />} />\n            </Badge>\n        </div>\n    )\n}\n\nexport default Basic\n","import Avatar from '@/components/ui/Avatar'\nimport Badge from '@/components/ui/Badge'\nimport { TbUser } from 'react-icons/tb'\n\nconst CountOverflow = () => {\n    return (\n        <div className=\"flex\">\n            <Badge className=\"mr-5\" content={10} maxCount={9}>\n                <Avatar icon={<TbUser />} />\n            </Badge>\n            <Badge className=\"mr-4\" content={100}>\n                <Avatar icon={<TbUser />} />\n            </Badge>\n        </div>\n    )\n}\n\nexport default CountOverflow\n","import Badge from '@/components/ui/Badge'\n\nconst Inline = () => {\n    return (\n        <div className=\"flex items-center\">\n            <Badge className=\"mr-4\" />\n            <Badge className=\"mr-4\" content={9} />\n            <Badge className=\"mr-4\" content={99} />\n            <Badge content={'New'} />\n        </div>\n    )\n}\n\nexport default Inline\n","import Badge from '@/components/ui/Badge'\n\nconst Color = () => {\n    return (\n        <div>\n            <div className=\"flex items-center\">\n                <Badge className=\"mr-4\" innerClass=\"bg-blue-500\" />\n                <Badge\n                    className=\"mr-4\"\n                    content={9}\n                    innerClass=\"bg-emerald-500\"\n                />\n                <Badge\n                    className=\"mr-4 font-semibold\"\n                    content={99}\n                    innerClass=\"bg-red-50 text-red-500\"\n                />\n                <Badge\n                    className=\"mr-4 border border-gray-400\"\n                    content={'New'}\n                    innerClass=\"bg-white text-gray-500\"\n                />\n            </div>\n        </div>\n    )\n}\n\nexport default Color\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["content","Content to show in badge","string | number","-"],["maxCount","Max number to show","number","99"],["innerClass","Class for badge inner","string","-"],["badgeStyle","Custom styling for Badge","object","-"]]]}