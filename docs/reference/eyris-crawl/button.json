{"url":"https://eyris-react.themenate.net/ui-components/button","title":"Button","intro":"Button is used to start an instant operation and is used when triggers an action or event","sections":[{"heading":"Variant"},{"heading":"Size"},{"heading":"Custome style"},{"heading":"Disabled"},{"heading":"Shape"},{"heading":"Icon"},{"heading":"Button With Icon"},{"heading":"Loading"},{"heading":"Block"},{"heading":"API"},{"heading":"Button"}],"codeCount":9,"code":["import Button from '@/components/ui/Button'\n\nconst Variant = () => {\n    return (\n        <div className=\"inline-flex flex-wrap xl:flex gap-2\">\n            <Button>Default</Button>\n            <Button variant=\"solid\">Solid</Button>\n            <Button variant=\"subtle\">Muted</Button>\n            <Button variant=\"link\">Link</Button>\n        </div>\n    )\n}\n\nexport default Variant\n","import Button from '@/components/ui/Button'\n\nconst Size = () => {\n    return (\n        <div className=\"xl:flex items-center gap-2\">\n            <Button size=\"sm\">Extra Small (xs)</Button>\n            <Button size=\"sm\">Small (sm)</Button>\n            <Button>Medium (md)</Button>\n            <Button size=\"lg\">Large (lg)</Button>\n        </div>\n    )\n}\n\nexport default Size\n","import Button from '@/components/ui/Button'\nimport classNames from 'classnames'\n\nconst Custom = () => {\n    return (\n        <div className=\"inline-flex gap-2\">\n            <Button\n                clickFeedback={false}\n                className={({ active, unclickable }) =>\n                    classNames(\n                        'text-gray-100 hover:text-gray-50 dark:hover:bg-red-500 border-0 hover:ring-0',\n                        active ? 'bg-red-700' : 'bg-red-500',\n                        unclickable && 'opacity-50 cursor-not-allowed',\n                        !active && !unclickable && 'hover:bg-red-400',\n                    )\n                }\n            >\n                Custom color\n            </Button>\n            <Button\n                clickFeedback={false}\n                className={({ active, unclickable }) =>\n                    classNames(\n                        'bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500  border-0 hover:ring-0 p-0.5',\n                        active\n                            ? 'bg-gradient-to-r from-pink-600 via-purple-600 to-blue-600'\n                            : '',\n                        unclickable && 'opacity-50 cursor-not-allowed',\n                        !active &&\n                            !unclickable &&\n                            'hover:bg-gradient-to-r hover:from-pink-400 hover:via-purple-400 hover:to-blue-400',\n                    )\n                }\n            >\n                <span className=\"relative px-5 h-full w-full flex items-center transition-all bg-white dark:bg-gray-900 rounded-md text-gray-900 dark:text-gray-100\">\n                    Gradient\n                </span>\n            </Button>\n        </div>\n    )\n}\n\nexport default Custom\n","import Button from '@/components/ui/Button'\n\nconst Disabled = () => {\n    return (\n        <div className=\"flex items-center gap-2\">\n            <Button disabled variant=\"default\">\n                Default\n            </Button>\n            <Button disabled variant=\"solid\">\n                Solid\n            </Button>\n            <Button disabled variant=\"subtle\">\n                Plain\n            </Button>\n        </div>\n    )\n}\n\nexport default Disabled\n","import Button from '@/components/ui/Button'\n\nconst Shape = () => {\n    return (\n        <div className=\"flex-wrap inline-flex xl:flex items-center gap-2\">\n            <Button>Rounded</Button>\n            <Button shape=\"none\">None</Button>\n            <Button shape=\"circle\">Circle</Button>\n        </div>\n    )\n}\n\nexport default Shape\n","import Button from '@/components/ui/Button'\nimport { HiPhone } from 'react-icons/hi'\n\nconst Icon = () => {\n    return (\n        <>\n            <div className=\"flex-wrap inline-flex xl:flex items-center gap-2\">\n                <Button shape=\"circle\" size=\"sm\" icon={<HiPhone />} />\n                <Button shape=\"circle\" size=\"sm\" icon={<HiPhone />} />\n                <Button shape=\"circle\" icon={<HiPhone />} />\n                <Button shape=\"circle\" size=\"lg\" icon={<HiPhone />} />\n            </div>\n            <br />\n            <div className=\"flex-wrap inline-flex xl:flex items-center gap-2\">\n                <Button size=\"sm\" icon={<HiPhone />} />\n                <Button size=\"sm\" icon={<HiPhone />} />\n                <Button icon={<HiPhone />} />\n                <Button size=\"lg\" icon={<HiPhone />} />\n            </div>\n        </>\n    )\n}\n\nexport default Icon\n","import { useState } from 'react'\nimport Button from '@/components/ui/Button'\nimport {\n    HiOutlineCog,\n    HiOutlinePencil,\n    HiOutlineInboxIn,\n    HiArrowNarrowRight,\n} from 'react-icons/hi'\n\nconst ButtonWithIcon = () => {\n    const [loading, setLoading] = useState(false)\n\n    const onClick = () => {\n        setLoading(true)\n\n        setTimeout(() => {\n            setLoading(false)\n        }, 3000)\n    }\n\n    return (\n        <div className=\"flex-wrap inline-flex xl:flex items-center gap-2\">\n            <Button className=\"mr-2\" icon={<HiOutlinePencil />}>\n                <span>Edit</span>\n            </Button>\n            <Button className=\"mr-2\" icon={<HiOutlineCog />}>\n                <span>\n                    <span>Settings</span>\n                </span>\n            </Button>\n            <Button\n                iconAlignment=\"end\"\n                className=\"mr-2\"\n                icon={<HiArrowNarrowRight />}\n            >\n                <span>Next</span>\n            </Button>\n            <Button\n                className=\"mr-2\"\n                variant=\"solid\"\n                loading={loading}\n                icon={<HiOutlineInboxIn />}\n                onClick={onClick}\n            >\n                <span>With Loading (Click to trigger)</span>\n            </Button>\n        </div>\n    )\n}\n\nexport default ButtonWithIcon\n","import { useState } from 'react'\nimport Button from '@/components/ui/Button'\nimport { HiPhone } from 'react-icons/hi'\n\nconst Loading = () => {\n    const [loading, setLoading] = useState(false)\n\n    const onClick = () => {\n        setLoading(true)\n\n        setTimeout(() => {\n            setLoading(false)\n        }, 3000)\n    }\n\n    return (\n        <div className=\"flex-wrap inline-flex xl:flex items-center gap-2\">\n            <Button loading>Loading</Button>\n            <Button shape=\"circle\" loading icon={<HiPhone />} />\n            <Button variant=\"solid\" loading={loading} onClick={onClick}>\n                Click Me!\n            </Button>\n        </div>\n    )\n}\n\nexport default Loading\n","import Button from '@/components/ui/Button'\n\nconst Block = () => {\n    return (\n        <div>\n            <Button className=\"mb-5\" block>\n                Block\n            </Button>\n            <Button variant=\"solid\" block>\n                Another Block\n            </Button>\n        </div>\n    )\n}\n\nexport default Block\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["active","Set button to active status","boolean","false"],["block","Make button fill to its container width","boolean","false"],["className","Custom class name for the button","string | (state: {active: boolean, unclickable: boolean}) => string","-"],["clickFeedback","Feedback effect upon button clicked","boolean","true"],["disabled","Prevents user interact with the button","boolean","false"],["icon","Render icon","string | ReactNode","-"],["loading","Show a loading spinner & disable the button","boolean","false"],["shape","Border radius of the button","'round' | 'circle' | 'none'","'round'"],["size","Size of the button.","'lg' | 'md' | 'sm' | 'xs'","'md'"],["variant","The variant of the button","'solid' | 'plain' | 'default'","'default'"]]]}