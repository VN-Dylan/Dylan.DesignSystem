{"url":"https://eyris-react.themenate.net/ui-components/dropdown","title":"Dropdown","intro":"Dropdown allow users select a single item from a list of options.","sections":["Default","Custom Toggle","Trigger","Submenu","Placement","Default Active","Disabled","Dropdown Item Type","Context Menu","With RouterLink","API","Dropdown","Dropdown.Item","Dropdown.Menu","Dropdown.ContextMenu"],"code":["import Dropdown from '@/components/ui/Dropdown'\nimport type { SyntheticEvent } from 'react'\n\nconst Default = () => {\n    const dropdownItems = [\n        { key: 'a', name: 'Item A' },\n        { key: 'b', name: 'Item B' },\n        { key: 'c', name: 'Item C' },\n        { key: 'd', name: 'Item D' },\n    ]\n\n    const onDropdownItemClick = (eventKey: string, e: SyntheticEvent) => {\n        console.log('Dropdown Item Clicked', eventKey, e)\n    }\n\n    const onDropdownClick = (e: SyntheticEvent) => {\n        console.log('Dropdown Clicked', e)\n    }\n\n    return (\n        <div>\n            <Dropdown title=\"Click Me!\" onClick={onDropdownClick}>\n                {dropdownItems.map((item) => (\n                    <Dropdown.Item\n                        key={item.key}\n                        eventKey={item.key}\n                        onSelect={onDropdownItemClick}\n                    >\n                        {item.name}\n                    </Dropdown.Item>\n                ))}\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default Default\n","import Dropdown from '@/components/ui/Dropdown'\nimport Button from '@/components/ui/Button'\n\nconst CustomToggle = () => {\n    const Toggle = <Button>Toggle as Button</Button>\n\n    return (\n        <div>\n            <Dropdown renderTitle={Toggle}>\n                <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n                <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n                <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n                <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default CustomToggle\n","import Dropdown from '@/components/ui/Dropdown'\n\nconst Trigger = () => {\n    return (\n        <div className=\"flex\">\n            <Dropdown title=\"Click\" className=\"mr-2\">\n                <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n                <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n                <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n                <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n            </Dropdown>\n            <Dropdown title=\"Hover\" trigger=\"hover\" className=\"mr-2\">\n                <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n                <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n                <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n                <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n            </Dropdown>\n            <Dropdown title=\"Right Click\" trigger=\"context\" className=\"mr-2\">\n                <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n                <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n                <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n                <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default Trigger\n","import Dropdown from '@/components/ui/Dropdown'\n\nconst Submenu = () => {\n    return (\n        <Dropdown title=\"Click Me!\">\n            <Dropdown.Item>Item 1</Dropdown.Item>\n            <Dropdown.Menu title=\"Right Item 2\">\n                <Dropdown.Menu title=\"Item 2-1\">\n                    <Dropdown.Item active>Item 2-1-1</Dropdown.Item>\n                    <Dropdown.Item>Item 2-1-2</Dropdown.Item>\n                    <Dropdown.Item>Item 2-1-3</Dropdown.Item>\n                </Dropdown.Menu>\n                <Dropdown.Item>Item 2-2</Dropdown.Item>\n                <Dropdown.Item>Item 2-3</Dropdown.Item>\n            </Dropdown.Menu>\n            <Dropdown.Menu title=\"Right Item 3\">\n                <Dropdown.Menu title=\"Item 3-1\">\n                    <Dropdown.Item>Item 3-1-1</Dropdown.Item>\n                    <Dropdown.Item>Item 3-1-2</Dropdown.Item>\n                    <Dropdown.Item>Item 3-1-3</Dropdown.Item>\n                </Dropdown.Menu>\n                <Dropdown.Item>Item 3-2</Dropdown.Item>\n                <Dropdown.Item>Item 3-3</Dropdown.Item>\n            </Dropdown.Menu>\n            <Dropdown.Item>Item 4</Dropdown.Item>\n        </Dropdown>\n    )\n}\n\nexport default Submenu\n","import Dropdown from '@/components/ui/Dropdown'\n\nconst DropdownItems = () => (\n    <>\n        <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n        <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n        <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n        <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n    </>\n)\n\nconst Placement = () => {\n    return (\n        <div className=\"grid grid-cols-3 gap-4 max-w-xl\">\n            <div>\n                <Dropdown placement=\"top-start\" title=\"Top start\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"top\" title=\"Top center\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"top-end\" title=\"Top end\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"bottom-start\" title=\"Bottom start\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"bottom\" title=\"Bottom center\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"bottom-end\" title=\"Bottom end\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"right-start\" title=\"Right start\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"right\" title=\"Right center\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"right-end\" title=\"Right end\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"left-start\" title=\"Left start\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"left\" title=\"Left center\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n            <div>\n                <Dropdown placement=\"left-end\" title=\"Left end\">\n                    <DropdownItems />\n                </Dropdown>\n            </div>\n        </div>\n    )\n}\n\nexport default Placement\n","import Dropdown from '@/components/ui/Dropdown'\n\nconst DefaultActive = () => {\n    return (\n        <div>\n            <Dropdown title=\"Click Me!\" activeKey=\"a\">\n                <Dropdown.Item eventKey=\"a\">Item A</Dropdown.Item>\n                <Dropdown.Item eventKey=\"b\">Item B</Dropdown.Item>\n                <Dropdown.Item eventKey=\"c\">Item C</Dropdown.Item>\n                <Dropdown.Item eventKey=\"d\">Item D</Dropdown.Item>\n            </Dropdown>\n            <Dropdown title=\"Click Me!\" activeKey=\"item-2-1-2\">\n                <Dropdown.Item eventKey=\"item-1\">Item 1</Dropdown.Item>\n                <Dropdown.Menu eventKey=\"item-2\" title=\"Item 2\">\n                    <Dropdown.Menu eventKey=\"item-2-1\" title=\"Item 2-1\">\n                        <Dropdown.Item eventKey=\"item-2-1-1\">\n                            Item 2-1-1\n                        </Dropdown.Item>\n                        <Dropdown.Item eventKey=\"item-2-1-2\">\n                            Item 2-1-2\n                        </Dropdown.Item>\n                        <Dropdown.Item eventKey=\"item-2-1-3\">\n                            Item 2-1-3\n                        </Dropdown.Item>\n                    </Dropdown.Menu>\n                    <Dropdown.Item eventKey=\"item-2-2\">Item 2-2</Dropdown.Item>\n                    <Dropdown.Item eventKey=\"item-2-3\">Item 2-3</Dropdown.Item>\n                </Dropdown.Menu>\n                <Dropdown.Item>Item 3</Dropdown.Item>\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default DefaultActive\n","import Dropdown from '@/components/ui/Dropdown'\nimport { TbUser, TbSettings2, TbLicense, TbHeadphones, TbUsers, TbHome, TbLogout } from \"react-icons/tb\";\nimport type { PropsWithChildren,  ReactNode } from 'react'\n\nconst DropdownItemWrapper = ({ children, icon, suffix }: PropsWithChildren<{\n    icon: ReactNode\n    suffix?: string | ReactNode\n}>) => {\n    return (\n        <div className=\"flex items-center justify-between gap-2 w-full\">\n            <div className=\"flex items-center gap-2\">\n                <span className=\"text-lg text-gray-400 dark:text-gray-400\">{icon}</span>\n                {children}\n            </div>\n            <span className=\"opacity-40\">{suffix}</span>\n        </div>\n    )\n}\n\nconst DropdownItemVariant = () => {\n    return (\n        <div>\n            <Dropdown title=\"Click Me!\">\n                <Dropdown.Item variant=\"header\">\n                    <div className=\"px-2 py-1.5 text-sm font-bold heading-text\">\n                        My Account\n                    </div>\n                </Dropdown.Item>\n                <Dropdown.Item variant=\"divider\" />\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbUser />} suffix=\"⇧ ⌘ P\">\n                        <span>Profile</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbSettings2 />} suffix=\"⌘ T\">\n                        <span>Setting</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbLicense />} suffix=\"⌘ L\">\n                        <span>License</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbHeadphones />} suffix=\"⌘ Y\">\n                        <span>Support</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item variant=\"divider\" />\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbUsers />} >\n                        <span>Team</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <DropdownItemWrapper icon={<TbHome />}>\n                        <span>Company Profile</span>\n                    </DropdownItemWrapper>\n                </Dropdown.Item>\n                <Dropdown.Item variant=\"divider\" />\n                <Dropdown.Item variant=\"custom\">\n                    <div\n                        className=\"\n\t\t\t\t\t\t\tcursor-pointer\n\t\t\t\t\t\t\tpx-3\n\t\t\t\t\t\t\tpy-2\n                            rounded-lg\n\t\t\t\t\t\t\tfont-semibold\n\t\t\t\t\t\t\thover:bg-gray-100\n\t\t\t\t\t\t\tdark:hover:bg-black/20\n                            text-red-400\n\t\t\t\t\t\t\"\n                    >\n                        <DropdownItemWrapper icon={<TbLogout />}>\n                            Logout\n                        </DropdownItemWrapper>\n                    </div>\n                </Dropdown.Item>\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default DropdownItemVariant\n","import Dropdown from '@/components/ui/Dropdown'\n\nconst ContextMenu = () => {\n    return (\n        <Dropdown.ContextMenu\n            areaClass=\"bg-gray-100 dark:bg-gray-700 rounded-lg h-[150px] flex items-center justify-center\"\n            areaContent={<span className=\"font-medium\">Right click here</span>}\n        >\n            <Dropdown.Item>Item 1</Dropdown.Item>\n            <Dropdown.Menu title=\"Right Item 2\">\n                <Dropdown.Menu title=\"Item 2-1\">\n                    <Dropdown.Item active>Item 2-1-1</Dropdown.Item>\n                    <Dropdown.Item>Item 2-1-2</Dropdown.Item>\n                    <Dropdown.Item>Item 2-1-3</Dropdown.Item>\n                </Dropdown.Menu>\n                <Dropdown.Item>Item 2-2</Dropdown.Item>\n                <Dropdown.Item>Item 2-3</Dropdown.Item>\n            </Dropdown.Menu>\n            <Dropdown.Menu title=\"Right Item 3\">\n                <Dropdown.Menu title=\"Item 3-1\">\n                    <Dropdown.Item>Item 3-1-1</Dropdown.Item>\n                    <Dropdown.Item>Item 3-1-2</Dropdown.Item>\n                    <Dropdown.Item>Item 3-1-3</Dropdown.Item>\n                </Dropdown.Menu>\n                <Dropdown.Item>Item 3-2</Dropdown.Item>\n                <Dropdown.Item>Item 3-3</Dropdown.Item>\n            </Dropdown.Menu>\n            <Dropdown.Item>Item 4</Dropdown.Item>\n        </Dropdown.ContextMenu>\n    )\n}\n\nexport default ContextMenu\n","import Dropdown from '@/components/ui/Dropdown'\nimport { Link } from 'react-router'\n\nconst WithRouterLink = () => {\n    return (\n        <div>\n            <Dropdown title=\"Click Me!\">\n                <Dropdown.Item>\n                    <Link\n                        className=\"menu-item-link\"\n                        to=\"/ui-components/checkbox\"\n                    >\n                        Checkbox\n                    </Link>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <Link className=\"menu-item-link\" to=\"/ui-components/button\">\n                        Button\n                    </Link>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <Link className=\"menu-item-link\" to=\"/ui-components/alert\">\n                        Alert\n                    </Link>\n                </Dropdown.Item>\n                <Dropdown.Item>\n                    <Link className=\"menu-item-link\" to=\"/ui-components/dialog\">\n                        Dialog\n                    </Link>\n                </Dropdown.Item>\n            </Dropdown>\n        </div>\n    )\n}\n\nexport default WithRouterLink\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["title","Dropdown title","string","-"],["renderTitle","Custom Dropdown title","ReactNode","-"],["trigger","Trigger mode of Dropdown","'click' | 'hover' | 'context'","'click'"],["placement","Placement where the Dropdown menu expand","'top-start' | 'top-center' | 'top-end' | 'bottom-start' | 'bottom-center' | 'bottom-end' | 'middle-start-top'| 'middle-start-bottom' | 'middle-end-top'| 'middle-end-bottom'","'bottom-start'"],["menuClass","Additional class for dropdown menu (! modifier recommended for tailwind css overiding)","string","-"],["menuStyle","Additional styles for dropdown menu","object","-"],["toggleClassName","Additional class dropdown toggle (! modifier recommended for tailwind css overiding)","string","-"],["disabled","Whether to disable Dropdown expand","boolean","-"],["activeKey","Mark corresponded Dropdown.Itemto active by matching it eventkey prop","string","-"],["onClick","Callback when Dropdown toggle is clicked","(e: MouseEvent) => void","-"],["onMouseEnter","Callback when Dropdown toggle is on mouse enter","(e: MouseEvent) => void","-"],["onMouseLeave","Callback when Dropdown toggle is on mouse leave","(e: MouseEvent) => void","-"],["onContextMenu","Callback when Dropdown toggle is right clicked","(e: MouseEvent) => void","-"],["onSelect","Callback when Dropdown item is clicked","(e: MouseEvent) => void","-"],["onOpen","Callback when Dropdown is open","() => void","-"],["onClose","Callback when Dropdown is close","() => void","-"],["onToggle","Callback when Dropdown is open or close","(open: boolean) => void","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["active","Whether active current Dropdown Item","boolean","-"],["disabled","Whether disabled current Dropdown Item","boolean","-"],["variant","Define the type of Dropdown Item","'default' | 'header' | 'divider' | 'custom'","-"],["eventKey","The value of Dropdown Item","string","-"],["onClick","Callback when Dropdown Item is clicked","() => void","-"],["onSelect","Callback when Dropdown Item is clicked","(eventKey: string, e: MouseEvent) => void","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["title","Title for submenu","string | ReactNode","-"],["eventKey","The value of Dropdown submenu","string","-"],["placement","Placement where the Dropdown menu expand","'top-start' | 'top-center' | 'top-end' | 'bottom-start' | 'bottom-center' | 'bottom-end' | 'middle-start-top'| 'middle-start-bottom' | 'middle-end-top'| 'middle-end-bottom'","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["areaClass","Additional class for dropdown area","string","-"],["areaContent","Additional content for dropdown area","ReactNode","-"],["areaRef","Ref object to access the internal dropdown area.","Ref<HTMLDivElement>","-"],["placement","Placement where the Dropdown menu expand","'top-start' | 'top-center' | 'top-end' | 'bottom-start' | 'bottom-center' | 'bottom-end' | 'middle-start-top'| 'middle-start-bottom' | 'middle-end-top'| 'middle-end-bottom'","'bottom-start'"],["menuClass","Additional class for dropdown menu (! modifier recommended for tailwind css overiding)","string","-"],["menuStyle","Additional styles for dropdown menu","object","-"],["disabled","Whether to disable Dropdown expand","boolean","-"],["activeKey","Mark corresponded Dropdown.Itemto active by matching it eventkey prop","string","-"],["onClick","Callback when Dropdown toggle is clicked","(e: MouseEvent) => void","-"],["onMouseEnter","Callback when Dropdown toggle is on mouse enter","(e: MouseEvent) => void","-"],["onMouseLeave","Callback when Dropdown toggle is on mouse leave","(e: MouseEvent) => void","-"],["onSelect","Callback when Dropdown item is clicked","(e: MouseEvent) => void","-"],["onOpen","Callback when Dropdown is open","() => void","-"],["onClose","Callback when Dropdown is close","() => void","-"],["onToggle","Callback when Dropdown is open or close","(open: boolean) => void","-"]]]}