{"url":"https://eyris-react.themenate.net/ui-components/radio","title":"Radio","intro":"Radios let users choose a single option in a series of options.","sections":["Simple","Group","Disabled","Vertical","Color","Controlled","API","Radio","Radio.Group"],"code":["import { useState } from 'react'\nimport Radio from '@/components/ui/Radio'\n\nconst Group = () => {\n    const [value, setValue] = useState('Banana')\n\n    const onChange = (val: string) => {\n        setValue(val)\n    }\n\n    return (\n        <div>\n            <Radio.Group value={value} onChange={onChange}>\n                <Radio value={'Apple'}>Apple</Radio>\n                <Radio value={'Banana'}>Banana</Radio>\n                <Radio value={'Cherry'}>Cherry</Radio>\n            </Radio.Group>\n        </div>\n    )\n}\n\nexport default Group\n","import Radio from '@/components/ui/Radio'\n\nconst Color = () => {\n    return (\n        <div>\n            <Radio defaultChecked radioClass=\"text-green-500\">\n                Radio\n            </Radio>\n            <div className=\"mt-4\">\n                <Radio.Group\n                    radioClass=\"text-yellow-500\"\n                    value={'Apple'}\n                    name=\"radioColorGroup\"\n                >\n                    <Radio radioClass=\"text-blue-600\" value={'Apple'}>\n                        Apple\n                    </Radio>\n                    <Radio value={'Banana'}>Banana</Radio>\n                    <Radio value={'Cherry'}>Cherry</Radio>\n                </Radio.Group>\n            </div>\n        </div>\n    )\n}\n\nexport default Color\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["checked","Whether the Radio is checked","boolean","-"],["radioClass","Custom css for Radio","string","-"],["defaultChecked","Whether the Radio initial state is checked","boolean","-"],["disabled","Whether the Radio is disabled","boolean","-"],["labelRef","Ref of Radio label element","string","-"],["name","The name of the Radio input field","string","-"],["onChange","Callback when Radio value is changed","(value: any, e: MouseEvent) => void","-"],["value","Value of Radio","any","-"],["vertical","Display Radio in vertical","boolean","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["color","Custom color for all radio in the group, available colors option based on tailwind theme.colors","string","current theme color"],["disabled","Whether to disable all radios","boolean","-"],["name","Name of radios under radio group","string","-"],["onChange","Callback when value is changed","(values: any, e: MouseEvent) => void","-"],["value","Specify selected value of radios","any","-"],["vertical","Display list of radios in vertical","boolean","false"]]]}