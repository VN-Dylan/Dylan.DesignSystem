{"url":"https://eyris-react.themenate.net/ui-components/avatar","title":"Avatar","intro":"Avatar component is used to represent a user or product brand, it can display text, icons, or images.","sections":["Shape","Size","Type","Color","Status","Avatar Group","API","Avatar","Avatar.Group"],"code":["import Avatar from '@/components/ui/Avatar'\nimport { TbUser } from 'react-icons/tb'\n\nconst Shape = () => {\n    return (\n        <div className=\"flex\">\n            <Avatar shape=\"square\" className=\"mr-4\" icon={<TbUser />} />\n            <Avatar shape=\"round\" className=\"mr-4\" icon={<TbUser />} />\n            <Avatar className=\"mr-4\" icon={<TbUser />} />\n        </div>\n    )\n}\n\nexport default Shape\n","import Avatar from '@/components/ui/Avatar'\nimport { TbUser } from 'react-icons/tb'\n\nconst Color = () => {\n    return (\n        <div className=\"flex items-center\">\n            <Avatar className=\"mr-4 bg-blue-100 dark:bg-blue-500/20 border-blue-100 dark:border-blue-500/20 text-blue-600  dark:text-indigo-100\">\n                A\n            </Avatar>\n            <Avatar\n                className=\"mr-4 bg-purple-500 border-purple-500 text-white\"\n                icon={<TbUser />}\n            />\n        </div>\n    )\n}\n\nexport default Color\n","import Avatar from '@/components/ui/Avatar'\nimport Badge from '@/components/ui/Badge'\nimport { TbUser } from 'react-icons/tb'\n\nconst Status = () => {\n    return (\n        <div className=\"flex items-center\">\n            <Badge\n                className=\"mr-4 rounded-full\"\n                badgeStyle={{ top: '7px', right: '5px' }}\n            >\n                <Avatar icon={<TbUser />} />\n            </Badge>\n            <Badge className=\"mr-4\">\n                <Avatar icon={<TbUser />} />\n            </Badge>\n            <Badge className=\"mr-4\" innerClass=\"bg-emerald-500\">\n                <Avatar icon={<TbUser />} />\n            </Badge>\n            <Badge className=\"mr-4\" content={99}>\n                <Avatar icon={<TbUser />} />\n            </Badge>\n        </div>\n    )\n}\n\nexport default Status\n","import Avatar from '@/components/ui/Avatar'\n\nconst Group = () => {\n    return (\n        <Avatar.Group\n            chained\n            omittedAvatarTooltip\n            maxCount={4}\n            omittedAvatarProps={{ shape: 'circle' }}\n            onOmittedAvatarClick={() => console.log('Omitted Avatar Clicked')}\n        >\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-1.jpg\" />\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-2.jpg\" />\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-3.jpg\" />\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-4.jpg\" />\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-5.jpg\" />\n            <Avatar shape=\"circle\" src=\"/img/avatars/thumb-6.jpg\" />\n        </Avatar.Group>\n    )\n}\n\nexport default Group\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["shape","Shape of Avatar","'rounded-sm' | 'square' | 'circle'","'rounded-sm'"],["size","Size of Avatar","'lg' | 'md' | 'sm' | number","'md'"],["icon","Avatar Icon","ReactNode","-"],["src","Image url of Avatar image","string","-"],["srcSet","srcset attribute for Avatar image","string","-"],["alt","alt attribute for Avatar image","string","-"]],[["PROP","DESCRIPTION","TYPE","DEFAULT"],["chained","Whether to stack avatars within group","boolean","false"],["maxCount","Limited avatars to display & append an ommited avatar","number","4"],["omittedAvatarContent","Custom omitted avatar content","string | ReactNode",""],["omittedAvatarProps","Omitted avatar props","Object (Refer to Avatar props above)","-"],["omittedAvatarTooltip","Whether to enable tooltip for omitted avatar","boolean","false"],["onOmittedAvatarClick","Callback when omitted avatar clicked","() => void","-"],["omittedAvatarTooltipProps","Props for omitted avatar tooltip, refer to tooltip props for details","Object","-"]]]}