{"url":"https://eyris-react.themenate.net/guide/shared-component-doc/info-bar","title":"InfoBar","intro":"InfoBar displays a signal strength indicator with three bars, commonly used to show levels like low, medium, or high intensity.","sections":["Basic","Custom Height","API","InfoBar"],"code":["import InfoBar from '@/components/shared/InfoBar'\n\nconst Basic = () => {\n    return (\n        <div className=\"flex items-center gap-8\">\n            <div className=\"flex items-center gap-2\">\n                <span className=\"text-sm\">Low:</span>\n                <InfoBar level=\"low\" />\n            </div>\n            <div className=\"flex items-center gap-2\">\n                <span className=\"text-sm\">Medium:</span>\n                <InfoBar level=\"medium\" />\n            </div>\n            <div className=\"flex items-center gap-2\">\n                <span className=\"text-sm\">High:</span>\n                <InfoBar level=\"high\" />\n            </div>\n        </div>\n    )\n}\n\nexport default Basic\n","import InfoBar from '@/components/shared/InfoBar'\n\nconst Levels = () => {\n    return (\n        <div className=\"flex items-center gap-8\">\n            <div className=\"flex items-center gap-2\">\n                <InfoBar level=\"low\" height={20} />\n                <span className=\"text-sm text-error\">Weak signal</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n                <InfoBar level=\"medium\" height={20} />\n                <span className=\"text-sm text-warning\">Moderate signal</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n                <InfoBar level=\"high\" height={20} />\n                <span className=\"text-sm text-success\">Strong signal</span>\n            </div>\n        </div>\n    )\n}\n\nexport default Levels\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["level","The level to display. Low shows 1 bar (red), medium shows 2 bars (yellow), high shows 3 bars (green)","\"low\" | \"medium\" | \"high\"","-"],["className","Additional CSS classes to apply to the container","string","-"],["height","Height of the info bar in pixels","number","15"]]]}