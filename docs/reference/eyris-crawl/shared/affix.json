{"url":"https://eyris-react.themenate.net/guide/shared-component-doc/affix","title":"Affix","intro":"Affix renders elemetns stick with a fixed position","sections":["Basic","Offset","API","Affix"],"code":["import Affix from '@/components/shared/Affix'\nimport Button from '@/components/ui/Button'\n\nconst Basic = () => {\n    return (\n        <div className=\"flex flex-col justify-between\">\n            <Affix className=\"z-50\">\n                <Button variant=\"solid\">This will stick to top</Button>\n            </Affix>\n            <div className=\"text-xl\">\n                <br />\n                Scroll down\n                <br />\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                <br />\n            </div>\n        </div>\n    )\n}\n\nexport default Basic\n","import Affix from '@/components/shared/Affix'\nimport Button from '@/components/ui/Button'\n\nconst Offset = () => {\n    return (\n        <div className=\"flex flex-col justify-between\">\n            <Affix offset={80} className=\"z-50\">\n                <Button variant=\"solid\">\n                    This will stick to top with 80px offset\n                </Button>\n            </Affix>\n            <div className=\"text-xl\">\n                <br />\n                Scroll down\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n                <br />\n                👇\n      