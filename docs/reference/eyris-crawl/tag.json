{"url":"https://eyris-react.themenate.net/ui-components/tag","title":"Tag","intro":"Tag component is used for categorize content with a keyword.","sections":["Basic","Affix","Custom","API","Tag"],"code":["import Tag from '@/components/ui/Tag'\n\nconst Basic = () => {\n    return (\n        <div className=\"flex\">\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag>Basic Tag</Tag>\n            </div>\n        </div>\n    )\n}\n\nexport default Basic\n","import Tag from '@/components/ui/Tag'\nimport { HiPlusCircle, HiX } from 'react-icons/hi'\n\nconst Affix = () => {\n    return (\n        <div className=\"flex\">\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag prefix>Tag 1</Tag>\n            </div>\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag prefix prefixClass=\"bg-emerald-500\">\n                    Tag 2\n                </Tag>\n            </div>\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag\n                    prefix={\n                        <HiPlusCircle className=\"text-base text-blue-500 mr-1 rtl:ml-1\" />\n                    }\n                >\n                    Tag 3\n                </Tag>\n            </div>\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag suffix suffixClass=\"bg-rose-500\">\n                    Tag 4\n                </Tag>\n            </div>\n            <div className=\"mr-2 rtl:ml-2\">\n                <Tag suffix={<HiX className=\"ml-1 rtl:mr-1 cursor-pointer\" />}>\n                    Tag 5\n                </Tag>\n            </div>\n        </div>\n    )\n}\n\nexport default Affix\n","import Tag from '@/components/ui/Tag'\nimport { PiCommandLight } from 'react-icons/pi'\nconst Custom = () => {\n    return (\n        <div className=\"flex flex-wrap gap-2\">\n            <Tag className=\"text-red-600 bg-red-100 dark:text-red-100 dark:bg-red-500/20 rounded-full border-0\">\n                Tag 1\n            </Tag>\n            <Tag className=\"bg-emerald-500 dark:bg-emerald-500 text-white border-0 rounded-sm\">\n                Tag 2\n            </Tag>\n            <Tag className=\"p-1\">\n                <PiCommandLight className=\"text-base\" />\n            </Tag>\n            <Tag className=\"p-1 font-mono\">Ctrl</Tag>\n        </div>\n    )\n}\n\nexport default Custom\n"],"tables":[[["PROP","DESCRIPTION","TYPE","DEFAULT"],["prefix","Tag prefix","boolean | ReactNode","false"],["prefixClass","Css class for Tag prefix, only available when prefix type is boolean","string","-"],["suffix","Tag suffix","boolean | ReactNode","false"],["suffixClass","Css class for Tag suffix, only available when suffix type is boolean","string","-"]]]}