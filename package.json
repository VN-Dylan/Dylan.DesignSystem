{
  "name": "@dylan-ds/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf --glob \"packages/*/tsconfig.tsbuildinfo\" \"packages/*/dist\" && pnpm -r --filter \"./packages/**\" build && tsc -b",
    "dev": "pnpm --filter @dylan-ds/showcase dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:api": "node scripts/api-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "rimraf --glob \"packages/*/tsconfig.tsbuildinfo\" \"apps/*/*.tsbuildinfo\" && tsc -b --pretty",
    "storybook": "storybook dev -p 6006 --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook -o storybook-static",
    "test:storybook": "concurrently -k -s first -n sb,test \"http-server storybook-static -p 6006 -a 127.0.0.1 --silent\" \"wait-on -t 60000 tcp:127.0.0.1:6006 && test-storybook --config-dir .storybook --url http://127.0.0.1:6006\"",
    "test:storybook:visual": "cross-env SB_VISUAL=1 concurrently -k -s first -n sb,test \"http-server storybook-static -p 6006 -a 127.0.0.1 --silent\" \"wait-on -t 60000 tcp:127.0.0.1:6006 && test-storybook --config-dir .storybook --url http://127.0.0.1:6006\"",
    "test:storybook:visual:update": "cross-env SB_VISUAL=1 concurrently -k -s first -n sb,test \"http-server storybook-static -p 6006 -a 127.0.0.1 --silent\" \"wait-on -t 60000 tcp:127.0.0.1:6006 && test-storybook --config-dir .storybook --url http://127.0.0.1:6006 --updateSnapshot\"",
    "changeset": "changeset",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules/.vite && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@eslint/js": "9.17.0",
    "@storybook/addon-a11y": "8.4.7",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-themes": "8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@storybook/test": "8.4.7",
    "@storybook/test-runner": "0.19.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "concurrently": "10.0.5",
    "cross-env": "7.0.3",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "eslint-plugin-storybook": "0.11.1",
    "globals": "15.14.0",
    "http-server": "14.1.1",
    "jest-axe": "9.0.0",
    "jest-image-snapshot": "6.5.2",
    "jsdom": "25.0.1",
    "playwright": "1.62.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.0.1",
    "sass": "1.83.0",
    "storybook": "8.4.7",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8",
    "wait-on": "9.1.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18",
        "react-dom": "18"
      }
    }
  }
}
